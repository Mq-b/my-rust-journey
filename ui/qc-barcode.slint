import { Button, LineEdit, VerticalBox, HorizontalBox, Palette,
         ScrollView, ListView } from "std-widgets.slint";

struct ProjectEntry {
    id: string,
    name: string,
}

export component MainWindow inherits Window {
    title: "QC Barcode Decoder";
    width: 640px;
    height: 480px;
    icon: @image-url("../assets/qc-icon.svg");

    // 手动输入
    in-out property <string> barcode-input: "";

    // 解析结果
    in-out property <string> project-id: "--";
    in-out property <string> project-name: "--";
    in-out property <string> lot-number: "--";
    in-out property <string> level: "--";
    in-out property <string> raw-barcode: "--";
    in-out property <string> error-message: "";
    in-out property <bool> is-error: false;

    // 项目配置
    in-out property <[ProjectEntry]> project-list: [];
    in-out property <bool> show-config: false;

    // 回调
    callback decode-input(string);
    callback open-config();
    callback save-config();
    callback add-project();
    callback remove-project(int);

    VerticalBox {
        spacing: 12px;

        // 标题栏
        HorizontalBox {
            height: 44px;
            spacing: 12px;

            Text {
                text: "QC Barcode Decoder";
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: root.show-config ? "返回解码" : "项目配置";
                clicked => {
                    root.show-config = !root.show-config;
                    if (root.show-config) {
                        root.open-config();
                    }
                }
            }
        }

        if !root.show-config: HorizontalBox {
            spacing: 16px;
            horizontal-stretch: 1;

            // 左侧：输入区域
            Rectangle {
                vertical-stretch: 1;
                width: 180px;
                background: Palette.alternate-background;
                border-radius: 8px;

                VerticalBox {
                    spacing: 12px;
                    padding: 16px;
                    alignment: center;

                    Text {
                        text: "输入6位条码";
                        font-size: 13px;
                        color: Palette.foreground.transparentize(40%);
                        horizontal-alignment: center;
                    }

                    LineEdit {
                        text: root.barcode-input;
                        placeholder-text: "1aa293";
                        font-size: 16px;
                        horizontal-alignment: center;
                        max-width: 120px;
                        accepted => {
                            root.decode-input(self.text);
                        }
                        edited => {
                            root.barcode-input = self.text;
                        }
                    }

                    Button {
                        text: "解码";
                        primary: true;
                        clicked => {
                            root.decode-input(root.barcode-input);
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // 右侧：解析结果
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: Palette.alternate-background;
                border-radius: 8px;

                VerticalBox {
                    spacing: 12px;
                    padding: 16px;

                    Text {
                        text: "解析结果";
                        font-size: 13px;
                        color: Palette.foreground.transparentize(40%);
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: Palette.control-background;
                        border-radius: 6px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                Text {
                                    text: "原始条码:";
                                    color: Palette.foreground.transparentize(50%);
                                    font-size: 13px;
                                    width: 80px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.raw-barcode;
                                    color: Palette.foreground;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle { height: 1px; background: Palette.foreground.transparentize(90%); }

                            HorizontalLayout {
                                Text {
                                    text: "项目 ID:";
                                    color: Palette.foreground.transparentize(50%);
                                    font-size: 13px;
                                    width: 80px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.project-id;
                                    color: Palette.accent-background;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "项目名称:";
                                    color: Palette.foreground.transparentize(50%);
                                    font-size: 13px;
                                    width: 80px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.project-name;
                                    color: Palette.accent-background;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "批次号:";
                                    color: Palette.foreground.transparentize(50%);
                                    font-size: 13px;
                                    width: 80px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.lot-number;
                                    color: Palette.accent-background;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: "Level:";
                                    color: Palette.foreground.transparentize(50%);
                                    font-size: 13px;
                                    width: 80px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.level;
                                    color: Palette.accent-background;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.show-config: Rectangle {
            vertical-stretch: 1;
            background: Palette.alternate-background;
            border-radius: 8px;

            VerticalBox {
                spacing: 12px;
                padding: 16px;

                HorizontalLayout {
                    Text {
                        text: "项目ID配置";
                        font-size: 13px;
                        color: Palette.foreground.transparentize(40%);
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "+ 新建";
                        clicked => {
                            root.add-project();
                        }
                    }
                }

                // 表头
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    padding-left: 8px;
                    padding-right: 52px;

                    Text {
                        text: "ID";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(50%);
                        width: 50px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "项目名称";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(50%);
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for entry[i] in root.project-list: Rectangle {
                        height: 40px;
                        background: Palette.control-background;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            Rectangle {
                                width: 50px;
                                LineEdit {
                                    text: entry.id;
                                    font-size: 14px;
                                    width: 100%;
                                    edited => {
                                        root.project-list[i].id = self.text;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                LineEdit {
                                    text: entry.name;
                                    font-size: 14px;
                                    width: 100%;
                                    edited => {
                                        root.project-list[i].name = self.text;
                                    }
                                }
                            }

                            Button {
                                text: "删除";
                                clicked => {
                                    root.remove-project(i);
                                }
                            }
                        }
                    }
                }

                Button {
                    text: "保存配置";
                    primary: true;
                    clicked => {
                        root.save-config();
                    }
                }
            }
        }

        // 提示信息
        if root.error-message != "": Rectangle {
            height: 32px;
            background: root.is-error ? #ff525220 : #4caf5020;
            border-radius: 4px;

            Text {
                text: root.error-message;
                color: root.is-error ? #ff5252 : #4caf50;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
